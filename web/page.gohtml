<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <title>bitbin</title>
    </head>
    <noscript>To upload a file, you must have JavaScript enabled</noscript>
    <body>
        <div class="nav">
            <a onclick="upload()">[upload]</a>
            <a href="{{ .Link }}" class="right">[{{ .LinkTitle }}]</a>
        </div>
        <div class="wrapper">
            <textarea id="content" placeholder="your content here..." autofocus spellcheck="false"></textarea>
        </div>
    </body>
    <style>
        * {
            font-family: monospace;
            box-sizing: border-box;
        }

        .nav {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 2em;
            background: #161b22;
            text-align: left;
            vertical-align: center;
            padding: 0.3em 0.5em;
        }

        .nav .right {
            float: right;
        }

        .nav a {
            text-decoration: none;
            cursor: pointer;
            color: #e4551d;
        }

        .wrapper {
            position: absolute;
            top: 2em;
            left: 0;
            right: 0;
            bottom: 0;
        }

        #content {
            background: #21262d;
            color: white;
            width: 100%;
            height: 100%;
            padding: 0.5em;
            resize: none;
            outline: none;
            border: 0;
            margin: 0;
        }
    </style>
    <script>
        async function upload() {
            const text = document.getElementById("content").value;
            if (!text) return;
            const data = await compress(text);

            const res = await fetch("/", {
                method: "POST",
                body: data,
                headers: {
                    "Content-Type": "text/plain",
                    "Content-Encoding": "gzip"
                }
            });

            if (res.status === 201) window.location.href = (await res.json()).key;
        }

        async function compress(text) {
            const str = new Blob([text]).stream();
            const compressed = str.pipeThrough(new CompressionStream("gzip"));
            const chunks = [];

            for await (const chunk of compressed) chunks.push(chunk);
            const blob = new Blob(chunks);
            const buf = await blob.arrayBuffer();
            return new Uint8Array(buf);
        }
    </script>
</html>